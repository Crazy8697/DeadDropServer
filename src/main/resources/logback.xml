<configuration>
  <appender name="OUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5level %logger{0} %msg%n</pattern></encoder>
  </appender>
  <logger name="io.ktor" level="WARN"/>
  <root level="INFO"><appender-ref ref="OUT"/></root>
</configuration>
